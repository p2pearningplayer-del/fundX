# ==============================================================================
# FundX Panel — Institutional Platform Environment Configuration
# ==============================================================================

# System Node Environment
NODE_ENV=production
PORT=3000

# Application URLs
NEXT_PUBLIC_APP_URL=https://fundx.enterprise.internal
NEXT_PUBLIC_API_URL=https://fundx.enterprise.internal/api

# JWT Authentication Secrets (Dual Token Architecture)
# Generate via: openssl rand -base64 48
JWT_ACCESS_SECRET=fundx_jwt_access_secret_super_secure_key_32chars_min_2026_x1
JWT_REFRESH_SECRET=fundx_jwt_refresh_secret_super_secure_key_32chars_min_2026_x2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic PII Vault (AES-256-GCM Encryption Key: 32 bytes hex encoded)
# Generate via: openssl rand -hex 32
AES_256_PII_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Connection (PostgreSQL ACID Ledger)
# Optional in dev: System falls back to embedded atomic store if DATABASE_URL is not set
DATABASE_URL=postgresql://fundx_admin:SuperSecretPass2026!@localhost:5432/fundx_db?sslmode=disable
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# TRC20 Blockchain Engine (TRON Mainnet / TronGrid RPC)
# Tether USDT Contract Address on TRON TRC20:
TRC20_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# System Central Receiving Hot Wallet for Activation Orders:
TRON_HOT_WALLET_ADDRESS=TXN9A5B8x7pKL2qRt1WvY3zEmP9sDcFeGh
# TronGrid API Key (Optional for high-frequency RPC queries):
TRONGRID_API_KEY=
TRON_RPC_ENDPOINT=https://api.trongrid.io

# Fund Base Quantum Defaults (INR)
GAMING_FUND_BASE_RATE=0.09
STOCK_FUND_BASE_RATE=0.18
MIX_FUND_BASE_RATE=0.24
TASK_MIN_AMOUNT=1000
TASK_MAX_AMOUNT=30000

# Superadmin Seed Credentials (Created on initial bootstrap)
INITIAL_SUPERADMIN_NAME="System Superadministrator"
INITIAL_SUPERADMIN_USERNAME="fundx_superadmin"
INITIAL_SUPERADMIN_MOBILE="9876543210"
INITIAL_SUPERADMIN_PASSWORD="FundX#AdminSecure2026!"

# Security Controls
RATE_LIMIT_MAX_REQUESTS_PER_MIN=120
SUSPICIOUS_LOGIN_IP_ANOMALY_DETECTION=true
MASK_BANK_ACCOUNT_NUMBERS=true
