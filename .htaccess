# ==============================================================================
# FundX Panel — Hostinger Production Web Server Configuration
# Target Domain: https://fundxx.in/
# ==============================================================================

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Block direct access to sensitive configuration files
    RewriteRule ^(\.env|\.git|database\.sql|schema\.sql|server-error\.log|data\/.*) - [F,L]
</IfModule>

# Hostinger CloudLinux / LiteSpeed Passenger Engine Integration
<IfModule mod_passenger.c>
    PassengerAppType node
    PassengerStartupFile server.js
</IfModule>

# Security & Optimization Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "origin-when-cross-origin"
</IfModule>
